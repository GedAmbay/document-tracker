# Application environment. Public signup stays disabled in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Default false; only honored in development. Never enables a production bypass.
DOCTRACK_DEMO_MODE=false
# Operator variables belong ONLY in a separate ignored operator environment:
# SUPABASE_OPERATOR_URL=http://localhost:54321
# SUPABASE_OPERATOR_DB_URL=postgresql://postgres:LOCAL_PASSWORD@localhost:54322/postgres
# SUPABASE_OPERATOR_SECRET_KEY=local_admin_key
# Never define operator/service-role secrets as NEXT_PUBLIC variables or in hosting.
